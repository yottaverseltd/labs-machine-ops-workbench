<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yottaverse.MachineOps.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#0B1118" />
                    <SolidColorBrush x:Key="WorkbenchChromeBrush" Color="#0E1720" />
                    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#111A24" />
                    <SolidColorBrush x:Key="WorkbenchMetricBrush" Color="#0E1720" />
                    <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#253445" />
                    <SolidColorBrush x:Key="WorkbenchMetricBorderBrush" Color="#213244" />
                    <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#DDE6EE" />
                    <SolidColorBrush x:Key="WorkbenchHeadingBrush" Color="#F4F7FA" />
                    <SolidColorBrush x:Key="WorkbenchMutedBrush" Color="#91A2B5" />
                    <SolidColorBrush x:Key="WorkbenchDimBrush" Color="#718399" />
                    <SolidColorBrush x:Key="WorkbenchEditorBrush" Color="#0B1118" />
                    <SolidColorBrush x:Key="WorkbenchEditorTextBrush" Color="#C7D4E1" />
                    <SolidColorBrush x:Key="WorkbenchSecondaryBrush" Color="#172332" />
                    <SolidColorBrush x:Key="WorkbenchSecondaryBorderBrush" Color="#304257" />
                    <SolidColorBrush x:Key="WorkbenchAlarmBrush" Color="#331E24" />
                    <SolidColorBrush x:Key="WorkbenchAlarmBorderBrush" Color="#71333D" />
                    <SolidColorBrush x:Key="WorkbenchAlarmTextBrush" Color="#F39AA2" />
                    <SolidColorBrush x:Key="WorkbenchPreviewBrush" Color="#17382F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkbenchBackgroundBrush" Color="#F3F6F9" />
                    <SolidColorBrush x:Key="WorkbenchChromeBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="WorkbenchMetricBrush" Color="#EDF2F7" />
                    <SolidColorBrush x:Key="WorkbenchBorderBrush" Color="#CDD6E0" />
                    <SolidColorBrush x:Key="WorkbenchMetricBorderBrush" Color="#D5DEE7" />
                    <SolidColorBrush x:Key="WorkbenchTextBrush" Color="#172331" />
                    <SolidColorBrush x:Key="WorkbenchHeadingBrush" Color="#0E1720" />
                    <SolidColorBrush x:Key="WorkbenchMutedBrush" Color="#586A7D" />
                    <SolidColorBrush x:Key="WorkbenchDimBrush" Color="#6E7F90" />
                    <SolidColorBrush x:Key="WorkbenchEditorBrush" Color="#F7F9FB" />
                    <SolidColorBrush x:Key="WorkbenchEditorTextBrush" Color="#233548" />
                    <SolidColorBrush x:Key="WorkbenchSecondaryBrush" Color="#E8EEF5" />
                    <SolidColorBrush x:Key="WorkbenchSecondaryBorderBrush" Color="#BCC8D5" />
                    <SolidColorBrush x:Key="WorkbenchAlarmBrush" Color="#FFF1F2" />
                    <SolidColorBrush x:Key="WorkbenchAlarmBorderBrush" Color="#E6A3A9" />
                    <SolidColorBrush x:Key="WorkbenchAlarmTextBrush" Color="#A92E3A" />
                    <SolidColorBrush x:Key="WorkbenchPreviewBrush" Color="#DDF6EB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <SolidColorBrush x:Key="WorkbenchAccentBrush" Color="#2B80FF" />
            <SolidColorBrush x:Key="WorkbenchAccentTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WorkbenchSuccessBrush" Color="#41D6A3" />
            <SolidColorBrush x:Key="WorkbenchSuccessBrightBrush" Color="#56E1B2" />
            <SolidColorBrush x:Key="WorkbenchWarningBrush" Color="#F6B84A" />
            <SolidColorBrush x:Key="WorkbenchErrorBrush" Color="#F17D85" />
            <SolidColorBrush x:Key="WorkbenchRapidBrush" Color="#60758D" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WorkbenchBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource WorkbenchSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.metric">
            <Setter Property="Background" Value="{DynamicResource WorkbenchMetricBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchMetricBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource WorkbenchAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchAccentTextBrush}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource WorkbenchSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WorkbenchSecondaryBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchDimBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchHeadingBrush}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedBrush}" />
        </Style>
        <Style Selector="TextBox.editor">
            <Setter Property="Background" Value="{DynamicResource WorkbenchEditorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchEditorTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchMutedBrush}" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource WorkbenchHeadingBrush}" />
        </Style>
    </Application.Styles>
</Application>
