<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yottaverse.MachineOps.Desktop.ViewModels"
        xmlns:controls="using:Yottaverse.MachineOps.Desktop.Controls"
        xmlns:gcode="using:Yottaverse.MachineOps.Core.GCode"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="Yottaverse.MachineOps.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="700"
        Title="MachineOps Workbench">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="64,*,34">
    <Border Grid.Row="0"
            Background="{DynamicResource WorkbenchChromeBrush}"
            BorderBrush="{DynamicResource WorkbenchBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="22,0" ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Border Width="34"
                  Height="34"
                  CornerRadius="7"
                  Background="{DynamicResource WorkbenchAccentBrush}">
            <Path Width="19"
                  Height="19"
                  Stretch="Uniform"
                  Fill="{DynamicResource WorkbenchAccentTextBrush}"
                  Data="M2,3 L9,3 L9,6 L12,6 L12,3 L19,3 L19,10 L16,10 L16,13 L19,13 L19,20 L12,20 L12,17 L9,17 L9,20 L2,20 L2,13 L5,13 L5,10 L2,10 Z" />
          </Border>
          <StackPanel Spacing="1">
            <TextBlock Text="MACHINEOPS" FontSize="15" FontWeight="Bold" LetterSpacing="1.1" />
            <TextBlock Text="WORKBENCH  /  LOCAL PREVIEW" Classes="eyebrow" FontSize="9" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="7">
          <Ellipse Width="8" Height="8" Fill="{DynamicResource WorkbenchSuccessBrush}" />
          <TextBlock Text="{Binding ApiStatus}" Classes="muted" FontSize="12" />
          <TextBlock Text="/" Classes="muted" FontSize="12" />
          <TextBlock Text="{Binding LiveStatus}" Classes="muted" FontSize="12" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="9">
          <Button Classes="secondary" Command="{Binding LoadSampleCommand}" Content="Load sample" />
          <Button Classes="secondary" Command="{Binding SaveJobCommand}" Content="Save job" />
          <Button Classes="primary" Command="{Binding OpenFileCommand}" Content="Open G-code" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22" ColumnDefinitions="290,*,350" ColumnSpacing="16">
      <Border Grid.Column="0" Classes="card">
        <Grid RowDefinitions="Auto,Auto,20,Auto,14,Auto,14,Auto,*">
          <TextBlock Text="PROGRAM" Classes="eyebrow" />
          <TextBlock Grid.Row="1"
                     Margin="0,7,0,0"
                     Text="{Binding FileName}"
                     TextWrapping="Wrap"
                     FontSize="18"
                     FontWeight="SemiBold" />

          <TextBlock Grid.Row="3" Text="INSPECTION" Classes="eyebrow" />

          <Border Grid.Row="5" Classes="metric">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Tool moves" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding SegmentCount}" FontSize="19" FontWeight="SemiBold" />
              </StackPanel>
              <PathIcon Width="18"
                        Foreground="{DynamicResource WorkbenchSuccessBrush}"
                        Data="M3,16 L8,11 L11,14 L18,7 M13,7 L18,7 L18,12" />
            </Grid>
          </Border>

          <StackPanel Grid.Row="7" Spacing="8">
            <Border Classes="metric">
              <StackPanel>
                <TextBlock Text="XY work area" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding WorkArea}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="metric">
              <StackPanel>
                <TextBlock Text="Travel distance" Classes="muted" FontSize="11" />
                <TextBlock Text="{Binding TravelDistance}" FontSize="15" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Classes="metric">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Findings" Classes="muted" FontSize="11" />
                  <TextBlock Text="{Binding WarningCount}" FontSize="15" FontWeight="SemiBold" />
                </StackPanel>
                <Ellipse Width="9"
                         Height="9"
                         Fill="{DynamicResource WorkbenchWarningBrush}"
                         VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>

          <Border Grid.Row="8" Margin="0,14,0,0" Classes="metric" VerticalAlignment="Bottom">
            <StackPanel Spacing="8">
              <TextBlock Text="SIMULATOR" Classes="eyebrow" />
              <TextBlock Text="{Binding MachineStatus}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding MachinePosition}"
                         Classes="muted"
                         FontSize="10"
                         FontFamily="Cascadia Mono, Consolas, monospace" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <StackPanel Spacing="1">
                  <TextBlock Text="FEED" Classes="eyebrow" FontSize="8" />
                  <TextBlock Text="{Binding MachineFeed}" Classes="muted" FontSize="10" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="SPINDLE" Classes="eyebrow" FontSize="8" />
                  <TextBlock Text="{Binding MachineSpindle}" Classes="muted" FontSize="10" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding RunState}" Classes="muted" FontSize="10" />
                <TextBlock Grid.Column="1"
                           Text="{Binding RunProgress, StringFormat='{}{0:0}%'}"
                           Foreground="{DynamicResource WorkbenchSuccessBrush}"
                           FontSize="10" />
              </Grid>
              <ProgressBar Minimum="0"
                           Maximum="100"
                           Value="{Binding RunProgress}"
                           Height="4"
                           ShowProgressText="False" />
              <TextBlock Text="{Binding ControllerError}"
                         Foreground="{DynamicResource WorkbenchErrorBrush}"
                         FontSize="10"
                         TextWrapping="Wrap" />
              <Border Background="{DynamicResource WorkbenchAlarmBrush}"
                      BorderBrush="{DynamicResource WorkbenchAlarmBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8"
                      IsVisible="{Binding HasOpenAlarm}">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding AlarmStatus}"
                             Foreground="{DynamicResource WorkbenchAlarmTextBrush}"
                             FontSize="10"
                             TextWrapping="Wrap" />
                  <Button Classes="secondary"
                          Padding="8,5"
                          FontSize="10"
                          Command="{Binding AcknowledgeAlarmCommand}"
                          Content="Acknowledge" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="7">
                <Button Classes="primary"
                        Command="{Binding ConnectSimulatorCommand}"
                        Content="Connect" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Command="{Binding DisconnectSimulatorCommand}"
                        Content="Disconnect" />
              </Grid>
              <Button Classes="primary" Command="{Binding StartRunCommand}" Content="Start saved job" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
                <Button Classes="secondary"
                        Padding="6,8"
                        FontSize="11"
                        Command="{Binding PauseRunCommand}"
                        Content="Pause" />
                <Button Grid.Column="1"
                        Classes="secondary"
                        Padding="6,8"
                        FontSize="11"
                        Command="{Binding ResumeRunCommand}"
                        Content="Resume" />
                <Button Grid.Column="2"
                        Classes="secondary"
                        Padding="6,8"
                        FontSize="11"
                        Command="{Binding CancelRunCommand}"
                        Content="Cancel" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,190" RowSpacing="16">
        <Border Classes="card" Padding="0">
          <Grid RowDefinitions="50,*">
            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="17,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <TextBlock Text="XY TOOLPATH" Classes="heading" />
                  <Border Background="{DynamicResource WorkbenchPreviewBrush}"
                          CornerRadius="10"
                          Padding="8,3">
                    <TextBlock Text="{Binding ToolpathMode}"
                               Foreground="{DynamicResource WorkbenchSuccessBrightBrush}"
                               FontSize="9"
                               FontWeight="Bold" />
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Width="18"
                               Height="2"
                               Fill="{DynamicResource WorkbenchSuccessBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Cut" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Rectangle Width="18"
                               Height="1"
                               Fill="{DynamicResource WorkbenchRapidBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Rapid" Classes="muted" FontSize="11" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{DynamicResource WorkbenchWarningBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="Tool" Classes="muted" FontSize="11" />
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <controls:ToolpathView Grid.Row="1"
                                   Segments="{Binding Segments}"
                                   CurrentPosition="{Binding LiveToolPosition}"
                                   Progress="{Binding RunProgress}"
                                   IsLive="{Binding HasLiveToolPosition}" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Classes="card" Padding="0">
          <Grid RowDefinitions="45,*">
            <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0">
              <TextBlock Text="VALIDATION" Classes="heading" FontSize="14" VerticalAlignment="Center" />
            </Border>
            <ListBox Grid.Row="1"
                     Margin="8"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Diagnostics}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="gcode:GCodeDiagnostic">
                  <Grid Margin="5,4" ColumnDefinitions="58,82,*">
                    <TextBlock Text="{Binding LineNumber, StringFormat='Line {0}'}"
                               Foreground="{DynamicResource WorkbenchDimBrush}"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="11" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Code}"
                               Foreground="{DynamicResource WorkbenchWarningBrush}"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               FontSize="11" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding Message}"
                               Foreground="{DynamicResource WorkbenchTextBrush}"
                               FontSize="11" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Classes="card" Padding="0">
        <TabControl Background="Transparent">
          <TabItem Header="SOURCE">
            <TextBox Classes="editor"
                     Margin="12"
                     Text="{Binding Source}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          </TabItem>
          <TabItem Header="ACTIVITY">
            <Grid Margin="12" RowDefinitions="Auto,Auto,*" RowSpacing="9">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                <TextBox PlaceholderText="Search jobs, runs, alarms and protocol"
                         Text="{Binding HistorySearch}" />
                <Button Grid.Column="1"
                        Classes="primary"
                        Command="{Binding SearchHistoryCommand}"
                        Content="Refresh" />
              </Grid>
              <TextBlock Grid.Row="1"
                         Text="{Binding HistorySummary}"
                         Classes="muted"
                         FontSize="10"
                         TextWrapping="Wrap" />
              <ListBox Grid.Row="2"
                       Background="Transparent"
                       BorderThickness="0"
                       ItemsSource="{Binding Activity}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityLine">
                    <Border BorderBrush="{DynamicResource WorkbenchBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="4,8">
                      <Grid ColumnDefinitions="48,54,*" ColumnSpacing="7">
                        <TextBlock Text="{Binding Time}"
                                   Foreground="{DynamicResource WorkbenchDimBrush}"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="9" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Kind}"
                                   Foreground="{DynamicResource WorkbenchSuccessBrightBrush}"
                                   FontSize="9"
                                   FontWeight="Bold" />
                        <StackPanel Grid.Column="2" Spacing="3">
                          <TextBlock Text="{Binding Summary}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}"
                                     Classes="muted"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="9"
                                     TextWrapping="Wrap"
                                     MaxHeight="46" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource WorkbenchChromeBrush}"
            BorderBrush="{DynamicResource WorkbenchBorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="22,0" ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}"
                   Foreground="{DynamicResource WorkbenchMutedBrush}"
                   FontSize="11"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text=".NET 10  /  AVALONIA 12  /  SIMULATOR SAFE"
                   Classes="eyebrow"
                   FontSize="9"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
